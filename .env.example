# Telegram bot token from @BotFather
TG_BOT_TOKEN=

# Telegram user_ids (numeric, comma-separated) allowed to use the bot.
# On first run, /start any user — the bot will log the incoming user_id; copy it here and restart.
# (The older singular TG_ALLOWED_USER_ID is still read and merged in.)
TG_ALLOWED_USER_IDS=

# Optional: watchers — one search profile per person the bot watches jobs for.
# Default is just search.toml. Add more to watch jobs for someone else too;
# each profile needs its own [search] watcher key. See profiles/README.md.
# JOBS_PROFILES=search.toml,profiles/anastasia.toml

# Optional: route each watcher's jobs to specific Telegram users —
# `watcher=user_id[,user_id];watcher2=user_id`. A user named here receives ONLY
# the watchers they're named for; watchers named nowhere go to every other
# subscriber. Unset → every subscriber gets every watcher.
# JOBS_WATCHER_USERS=anastasia=499184201

# Optional: override defaults
# JOBS_DB_PATH=data/jobs.db
# JOBS_TZ=Asia/Ho_Chi_Minh
# JOBS_SCHEDULE_TIMES=09:00,21:00
# JOBS_MAX_PAGES=3
# JOBS_MAX_AGE_DAYS=60
# PLAYWRIGHT_BROWSERS_PATH=/Users/you/Library/Caches/ms-playwright

# What role to search for (keywords + location eligibility) lives in search.toml,
# NOT here. Copy search.example.toml → search.toml, or run /setup-search.
